{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chebihiF/agent-factory/contracts/agent-event.schema.json",
  "title": "AgentEvent",
  "description": "Événement de hook d'agent envoyé par le Mac au dashboard. Métadonnées uniquement : aucun prompt, aucune sortie d'outil, aucune donnée d'enfant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "ts", "hook_event_name", "session_id"],
  "properties": {
    "event_id": {
      "description": "Identifiant unique de l'événement (clé d'idempotence), ex. UUID.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "description": "Horodatage ISO 8601 avec fuseau.",
      "type": "string",
      "format": "date-time"
    },
    "hook_event_name": {
      "description": "Nom du hook, ex. PreToolUse, PostToolUse, SubagentStop.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agent_type": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "agent_id": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "tool_name": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "project": {
      "description": "Projet émetteur (nom de dépôt GitHub). Absent = \"viral-video-agents\" : événements antérieurs au #68.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "default": "viral-video-agents"
    },
    "issue": {
      "description": "Ticket GitHub déduit de la branche `<type>/<n>-…` de l'émetteur (#181). Absent ou null = inconnu.",
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 999999999
    },
    "model": {
      "description": "Modèle de l'agent tel que fourni par le hook (#181). Absent ou null = inconnu.",
      "type": ["string", "null"],
      "maxLength": 128
    }
  },
  "examples": [
    {
      "event_id": "6f1c2e0a-1b2c-4d5e-8f90-0a1b2c3d4e5f",
      "ts": "2026-11-18T10:00:00+00:00",
      "hook_event_name": "SubagentStart",
      "session_id": "sess-1",
      "agent_type": "dev-backend",
      "agent_id": "agent-42",
      "tool_name": null
    },
    {
      "event_id": "0b7d9a52-3c4e-4f60-9a1b-2c3d4e5f6a7b",
      "ts": "2026-11-20T09:30:00+00:00",
      "hook_event_name": "PostToolUse",
      "session_id": "sess-2",
      "agent_type": "reviewer",
      "agent_id": "agent-7",
      "tool_name": "Bash",
      "project": "agent-factory"
    },
    {
      "event_id": "3e5a7c91-2b4d-4e6f-8a0b-1c2d3e4f5a6b",
      "ts": "2026-11-20T11:00:00+00:00",
      "hook_event_name": "SubagentStart",
      "session_id": "sess-3",
      "agent_type": "dev-backend",
      "agent_id": "agent-9",
      "tool_name": null,
      "project": "agent-factory",
      "issue": 181,
      "model": "claude-opus-5-5"
    }
  ]
}
