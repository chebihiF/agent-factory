# Copié en /opt/vva/proxy.env sur le VPS (Traefik du projet Docker « n8n » : réseau n8n_default)
PROXY_NETWORK=n8n_default
TLS_ENTRYPOINT=websecure
CERT_RESOLVER=mytlschallenge
DASHBOARD_HOST=dashboard.example.com
# Facultatif (#185) : proxys de confiance pour X-Forwarded-For ; vide => sous-réseau de PROXY_NETWORK. Jamais « * ».
# FORWARDED_ALLOW_IPS=172.18.0.0/16
